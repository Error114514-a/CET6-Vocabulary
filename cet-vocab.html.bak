    // ========================================
    // 四、Fisher-Yates 洗牌算法
    // ========================================
    function fisherYatesShuffle(arr) {
      var a = arr.slice();
      for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var temp = a[i];
        a[i] = a[j];
        a[j] = temp;
      }
      return a;
    }

    // ========================================
    // 五、localStorage 存储管理
    // ========================================
    var Storage = {
      getUsers: function() {
        var raw = localStorage.getItem('cet_users');
        return raw ? JSON.parse(raw) : {};
      },
      saveUsers: function(users) {
        localStorage.setItem('cet_users', JSON.stringify(users));
      },
      getUserMastered: function(username) {
        var users = this.getUsers();
        return (users[username] && users[username].mastered) ? users[username].mastered : [];
      },
      saveUserMastered: function(username, mastered) {
        var users = this.getUsers();
        if (!users[username]) users[username] = { password: '', mastered: [] };
        users[username].mastered = mastered;
        this.saveUsers(users);
      },
      getGuestMastered: function() {
        var raw = localStorage.getItem('cet_guest_mastered');
        return raw ? JSON.parse(raw) : [];
      },
      saveGuestMastered: function(mastered) {
        localStorage.setItem('cet_guest_mastered', JSON.stringify(mastered));
      },
      getSession: function() {
        var raw = localStorage.getItem('cet_session');
        return raw ? JSON.parse(raw) : null;
      },
      saveSession: function(username) {
        localStorage.setItem('cet_session', JSON.stringify({ username: username }));
      },
      clearSession: function() {
        localStorage.removeItem('cet_session');
      }
    };

    // ========================================
    // 六、用户注册与登录
    // ========================================
    els.btnRegister.addEventListener('click', function() {
      var username = els.regUsername.value.trim();
      var password = els.regPassword.value.trim();
      var password2 = els.regPassword2.value.trim();
      if (username.length < 2 || username.length > 20) { alert('用户名需要2-20个字符'); return; }
      if (password.length < 6 || password.length > 20) { alert('密码需要6-20个字符'); return; }
      if (password !== password2) { alert('两次密码输入不一致'); return; }
      var users = Storage.getUsers();
      if (users[username]) { alert('该用户名已被注册'); return; }
      users[username] = { password: password, mastered: [] };
      Storage.saveUsers(users);
      alert('注册成功！请登录');
      switchToLogin();
      els.loginUsername.value = username;
    });

    els.btnLogin.addEventListener('click', function() {
      var username = els.loginUsername.value.trim();
      var password = els.loginPassword.value.trim();
      if (!username || !password) { alert('请输入用户名和密码'); return; }
      var users = Storage.getUsers();
      if (!users[username]) { alert('用户不存在，请先注册'); return; }
      if (users[username].password !== password) { alert('密码错误'); return; }
      currentUser = { username: username };
      isGuest = false;
      Storage.saveSession(username);
      enterApp();
    });

    els.btnGuest.addEventListener('click', function() {
      currentUser = null;
      isGuest = true;
      Storage.clearSession();
      enterApp();
    });

    els.switchToRegister.addEventListener('click', switchToRegister);
    els.switchToLogin.addEventListener('click', switchToLogin);

    function switchToRegister() {
      els.loginForm.style.display = 'none';
      els.registerForm.style.display = 'block';
    }
    function switchToLogin() {
      els.registerForm.style.display = 'none';
      els.loginForm.style.display = 'block';
    }

    // ========================================
    // 七、进入应用
    // ========================================
    function enterApp() {
      els.authPage.classList.remove('active');
      els.authPage.style.display = 'none';
      els.topBar.style.display = 'flex';
      els.mainContent.style.display = 'block';
      els.bottomNav.style.display = 'flex';
      els.userName.textContent = isGuest ? '游客' : currentUser.username;
      loadMasteredWords();
      showPage('startPage');
    }

    // ========================================
    // 八、退出登录
    // ========================================
    els.navLogout.addEventListener('click', function() {
      if (!confirm('确定要退出吗？')) return;
      currentUser = null;
      isGuest = false;
      audioUnlocked = false;
      studyQueue = [];
      Storage.clearSession();
      els.authPage.style.display = 'flex';
      els.authPage.classList.add('active');
      els.topBar.style.display = 'none';
      els.mainContent.style.display = 'none';
      els.bottomNav.style.display = 'none';
      els.loginUsername.value = '';
      els.loginPassword.value = '';
      switchToLogin();
    });

    // ========================================
    // 九、已斩单词管理
    // ========================================
    function loadMasteredWords() {
      var list;
      if (isGuest) {
        list = Storage.getGuestMastered();
      } else if (currentUser) {
        list = Storage.getUserMastered(currentUser.username);
      } else {
        list = [];
      }
      masteredSet = {};
      list.forEach(function(w) { masteredSet[w] = true; });
    }

    function saveMasteredWords() {
      var list = Object.keys(masteredSet);
      if (isGuest) {
        Storage.saveGuestMastered(list);
      } else if (currentUser) {
        Storage.saveUserMastered(currentUser.username, list);
      }
    }

    function getMasteredCount() {
      return Object.keys(masteredSet).length;
    }

    // ========================================
    // 十、构建乱序学习队列
    // ========================================
    function buildShuffledQueue() {
      var remaining = WORD_LIST.filter(function(w) {
        return !masteredSet[w.word];
      });
      if (remaining.length === 0) {
        studyQueue = [];
        return;
      }
      studyQueue = fisherYatesShuffle(remaining);
      currentQueueIndex = 0;
    }

    // ========================================
    // 十一、Web Speech API 音频管理
    // ========================================
    var SpeechManager = {
      voices: [],
      initialized: false,

      init: function() {
        if (!('speechSynthesis' in window)) return;
        var self = this;
        this.voices = speechSynthesis.getVoices();
        if (typeof speechSynthesis.addEventListener === 'function') {
          speechSynthesis.addEventListener('voiceschanged', function() {
            self.voices = speechSynthesis.getVoices();
            self.initialized = true;
          });
        }
        var attempts = 0;
        var pollTimer = setInterval(function() {
          attempts++;
          self.voices = speechSynthesis.getVoices();
          if (self.voices.length > 0 || attempts > 20) {
            self.initialized = true;
            clearInterval(pollTimer);
          }
        }, 100);
        if (this.voices.length > 0) this.initialized = true;
      },

      unlock: function() {
        if (audioUnlocked) return;
        if (!('speechSynthesis' in window)) return;
        var unlocker = new SpeechSynthesisUtterance('');
        unlocker.volume = 0;
        speechSynthesis.speak(unlocker);
        audioUnlocked = true;
      },

      speak: function(text, lang, callback) {
        if (!('speechSynthesis' in window)) {
          if (callback) callback();
          return;
        }
        speechSynthesis.cancel();
        var myId = ++speechIdCounter;
        var utter = new SpeechSynthesisUtterance(text);
        utter.lang = lang || 'en-US';
        utter.rate = (lang === 'zh-CN') ? 1.0 : 0.85;
        utter.pitch = 1.0;
        utter.volume = 1.0;
        if (this.voices.length > 0) {
          for (var i = 0; i < this.voices.length; i++) {
            if (this.voices[i].lang === utter.lang) {
              utter.voice = this.voices[i];
              break;
            }
          }
        }
        utter.onend = function() {
          if (myId === speechIdCounter && callback) callback();
        };
        utter.onerror = function() {
          if (myId === speechIdCounter && callback) callback();
        };
        speechSynthesis.speak(utter);
      }
    };

    SpeechManager.init();

    // ========================================
    // 十二、"开始刷词"按钮
    // ========================================
    els.btnStart.addEventListener('click', function() {
      SpeechManager.unlock();
      buildShuffledQueue();
      if (studyQueue.length === 0) {
        showPage('donePage');
        return;
      }
      showPage('wordPage');
      els.navWord.classList.add('active');
      els.navRank.classList.remove('active');
      renderCard();
      setTimeout(autoPlayCurrentWord, 300);
    });

    // ========================================
    // 十三、渲染当前单词卡片
    // ========================================
    function renderCard() {
      if (studyQueue.length === 0) {
        showPage('donePage');
        return;
      }
      if (currentQueueIndex >= studyQueue.length) currentQueueIndex = 0;
      var word = studyQueue[currentQueueIndex];
      var hues = [260, 200, 340, 30, 150, 280, 15, 190];
      var hue = hues[word.word.charCodeAt(0) % hues.length];
      els.cardImage.style.background = 'linear-gradient(135deg, hsl(' + hue + ',70%,65%), hsl(' + (hue + 40) + ',70%,55%))';
      els.cardEmoji.textContent = word.emoji;
      els.wordText.textContent = word.word;
      els.wordPhonetic.textContent = word.phonetic;
      els.wordMeaning.textContent = word.meaning;
      els.exampleEn.textContent = word.example;
      els.exampleCn.textContent = word.exampleCn;
      var totalMastered = getMasteredCount();
      var progress = (totalMastered / WORD_LIST.length) * 100;
      els.progressFill.style.width = progress + '%';
      var globalIndex = -1;
      for (var i = 0; i < WORD_LIST.length; i++) {
        if (WORD_LIST[i].word === word.word) { globalIndex = i; break; }
      }
      els.currentIndex.textContent = globalIndex >= 0 ? (globalIndex + 1) : (currentQueueIndex + 1);
      els.totalCount.textContent = WORD_LIST.length;
      els.todayCount.textContent = '已斩 ' + totalMastered;
    }

    // ========================================
    // 十四、自动播放当前单词音频
    // ========================================
    function autoPlayCurrentWord() {
      if (!audioUnlocked) return;
      if (studyQueue.length === 0) return;
      var word = studyQueue[currentQueueIndex];
      SpeechManager.speak(word.word, 'en-US', null);
    }

    // ========================================
    // 十五、操作按钮事件
    // ========================================
    els.btnMastered.addEventListener('click', function() {
      if (studyQueue.length === 0) return;
      var word = studyQueue[currentQueueIndex];
      if (word && !masteredSet[word.word]) {
        masteredSet[word.word] = true;
        saveMasteredWords();
      }
      animateCardOut('mastered');
      setTimeout(function() {
        currentQueueIndex++;
        if (currentQueueIndex >= studyQueue.length) {
          buildShuffledQueue();
          if (studyQueue.length === 0) {
            showPage('donePage');
            return;
          }
        }
        renderCard();
        animateCardIn();
        setTimeout(autoPlayCurrentWord, 350);
      }, 300);
    });

    els.btnSkip.addEventListener('click', function() {
      if (studyQueue.length === 0) return;
      animateCardOut('skip');
      setTimeout(function() {
        currentQueueIndex++;
        if (currentQueueIndex >= studyQueue.length) currentQueueIndex = 0;
        renderCard();
        animateCardIn();
        setTimeout(autoPlayCurrentWord, 350);
      }, 300);
    });

    els.btnReset.addEventListener('click', function() {
      if (!confirm('确定要重置所有进度吗？已斩记录将全部清除！')) return;
      masteredSet = {};
      saveMasteredWords();
      buildShuffledQueue();
      showPage('wordPage');
      els.navWord.classList.add('active');
      els.navRank.classList.remove('active');
      renderCard();
      setTimeout(autoPlayCurrentWord, 300);
    });

    // ========================================
    // 十六、手动音频按钮
    // ========================================
    els.audioBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (studyQueue.length === 0) return;
      SpeechManager.unlock();
      var word = studyQueue[currentQueueIndex];
      SpeechManager.speak(word.word, 'en-US', null);
    });

    els.audioBtnExample.addEventListener('click', function(e) {
      e.stopPropagation();
      if (studyQueue.length === 0) return;
      SpeechManager.unlock();
      var word = studyQueue[currentQueueIndex];
      SpeechManager.speak(word.example, 'en-US', null);
    });

    // ========================================
    // 十七、卡片动画
    // ========================================
    function animateCardOut(type) {
      var card = els.wordCard;
      card.style.transition = 'all 0.3s ease';
      if (type === 'mastered') {
        card.style.transform = 'translateX(120%) rotate(15deg)';
        card.style.opacity = '0';
      } else {
        card.style.transform = 'translateX(-120%) rotate(-15deg)';
        card.style.opacity = '0';
      }
    }

    function animateCardIn() {
      var card = els.wordCard;
      card.style.transition = 'none';
      card.style.transform = 'translateY(20px)';
      card.style.opacity = '0';
      setTimeout(function() {
        card.style.transition = 'all 0.35s ease';
        card.style.transform = 'translateX(0) rotate(0)';
        card.style.opacity = '1';
      }, 20);
    }

    // ========================================
    // 十八、页面切换
    // ========================================
    function showPage(pageId) {
      var pages = document.querySelectorAll('.page');
      pages.forEach(function(p) { p.classList.remove('active'); });
      document.getElementById(pageId).classList.add('active');
    }

    els.navWord.addEventListener('click', function() {
      if (studyQueue.length === 0 && getMasteredCount() < WORD_LIST.length) {
        buildShuffledQueue();
      }
      if (studyQueue.length === 0) {
        showPage('donePage');
      } else {
        showPage('wordPage');
        renderCard();
      }
      els.navWord.classList.add('active');
      els.navRank.classList.remove('active');
    });

    els.navRank.addEventListener('click', function() {
      showPage('rankPage');
      els.navRank.classList.add('active');
      els.navWord.classList.remove('active');
      renderRank();
    });

    // ========================================
    // 十九、排行榜
    // ========================================
    function renderRank() {
      var fakeUsers = [];
      var allUsers = fakeUsers.slice();
      var users = Storage.getUsers();
      Object.keys(users).forEach(function(username) {
        var mastered = users[username].mastered || [];
        allUsers.push({ name: username, count: mastered.length, isReal: true });
      });
      var myCount = getMasteredCount();
      if (isGuest) {
        els.rankNote.textContent = '游客模式不保存进度，请注册登录参与排名。已斩词数：' + myCount;
      } else if (currentUser) {
        allUsers = allUsers.map(function(u) {
          if (u.name === currentUser.username) {
            u.count = myCount;
            u.isMe = true;
          }
          return u;
        });
        els.rankNote.textContent = '';
      } else {
        els.rankNote.textContent = '';
      }

      if (allUsers.length === 0) {
        els.rankNote.textContent = '暂无注册用户，成为第一个上榜的人吧！';
      } else if (allUsers.length === 1 && !isGuest && currentUser) {
        els.rankNote.textContent = '目前只有你一个人，邀请朋友一起来刷词吧！';
      }
      allUsers.sort(function(a, b) { return b.count - a.count; });
      var html = allUsers.map(function(user, i) {
        var rankClass = user.isMe ? 'rank-item me' : 'rank-item';
        var meLabel = user.isMe ? ' （我）' : '';
        return '<div class="' + rankClass + '">' +
          '<div class="rank-num">' + (i + 1) + '</div>' +
          '<div class="rank-name">' + user.name + meLabel + '</div>' +
          '<div class="rank-count">' + user.count + ' 词</div>' +
          '</div>';
      }).join('');
      if (isGuest) {
        var myRankIndex = 0;
        for (var i = 0; i < allUsers.length; i++) {
          if (allUsers[i].count > myCount) myRankIndex++;
        }
        html += '<div class="rank-item me" style="opacity:0.6">' +
          '<div class="rank-num">' + (myRankIndex + 1) + '</div>' +
          '<div class="rank-name">游客 （我）</div>' +
          '<div class="rank-count">' + myCount + ' 词</div>' +
          '</div>';
      }
      els.rankList.innerHTML = html;
    }

    // ========================================
    // 二十、自动恢复登录状态 & 初始化
    // ========================================
    function autoRestoreSession() {
      var session = Storage.getSession();
      if (session && session.username) {
        var users = Storage.getUsers();
        if (users[session.username]) {
          currentUser = { username: session.username };
          isGuest = false;
          enterApp();
        }
      }
    }

    autoRestoreSession();
  </script>
</body>
</html>
